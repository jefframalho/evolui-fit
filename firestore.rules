rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) { return request.auth != null && request.auth.uid == uid; }
    function optionalNumber(d, key, min, max) {
      return !(key in d) || ((d[key] is int || d[key] is float) && d[key] >= min && d[key] <= max);
    }
    function optionalNotes(d) { return !('notes' in d) || (d.notes is string && d.notes.size() <= 2000); }
    function validData(r) {
      let d = r.data;
      return optionalNotes(d) && (
        (r.kind == 'measure'
          && d.keys().hasOnly(['weight','waist','chest','arm','thigh','hip','notes'])
          && d.keys().hasAny(['weight','waist','chest','arm','thigh','hip'])
          && optionalNumber(d,'weight',0.1,1000) && optionalNumber(d,'waist',0.1,1000)
          && optionalNumber(d,'chest',0.1,1000) && optionalNumber(d,'arm',0.1,1000)
          && optionalNumber(d,'thigh',0.1,1000) && optionalNumber(d,'hip',0.1,1000))
        || (r.kind == 'goal'
          && d.keys().hasOnly(['targetWeight','weekly','notes'])
          && d.keys().hasAny(['targetWeight','weekly'])
          && optionalNumber(d,'targetWeight',0.1,1000) && optionalNumber(d,'weekly',1,14)
          && (!('weekly' in d) || d.weekly is int))
        || (r.kind == 'habit'
          && d.keys().hasOnly(['water','sleep','mood','meals','notes'])
          && d.keys().size() > 0
          && optionalNumber(d,'water',0,20) && optionalNumber(d,'sleep',0.1,24)
          && (!('mood' in d) || d.mood in ['Com energia','Bem','Cansado','Desanimado'])
          && (!('meals' in d) || (d.meals is string && d.meals.size() <= 3000)))
        || (r.kind == 'workout'
          && d.keys().hasOnly(['name','duration','exercises','notes'])
          && d.keys().hasAll(['name','duration','exercises'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 100
          && d.duration is int && d.duration >= 1 && d.duration <= 1440
          && d.exercises is list && d.exercises.size() >= 1 && d.exercises.size() <= 50)
      );
    }
    match /users/{uid}/records/{recordId} {
      allow get, list: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasAll(['kind','date','data','createdAt'])
        && request.resource.data.keys().hasOnly(['kind','date','data','createdAt'])
        && request.resource.data.kind in ['workout','measure','habit','goal']
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.data is map
        && request.resource.data.createdAt == request.time
        && validData(request.resource.data);
      allow delete: if isOwner(uid);
      allow update: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
