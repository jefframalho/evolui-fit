{
  "name": "evolui-fit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite --config vite.web.config.ts",
    "build": "vite build --config vite.web.config.ts",
    "build:web": "vite build --config vite.web.config.ts",
    "check": "tsc --noEmit",
    "test:validation": "node scripts/check-validation.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-evolui-fit 'node scripts/check-firestore.mjs'",
    "test:timer": "node scripts/check-timer.mjs"
  },
  "dependencies": {
    "firebase": "^13.1.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "lucide-react": "^1.31.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase-tools": "^15.34.2"
  }
}
